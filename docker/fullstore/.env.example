# Copy to `.env` (gitignored) and fill in your license key.
#   cp .env.example .env

# CS-Cart license key (REQUIRED — the console installer refuses without it).
CSCART_LICENSE_KEY=REPLACE_WITH_YOUR_LICENSE_KEY

# Admin account created during install.
CSCART_ADMIN_EMAIL=admin@example.com
CSCART_ADMIN_PASSWORD=admin

# The host:port the store answers on. MUST match HTTP_PORT below, otherwise
# CS-Cart builds links with the wrong port and redirects break.
CSCART_HTTP_HOST=localhost:8080

# Storefront theme installed on first provision. Leave EMPTY for auto:
# nova_theme when the kit ships it (the modern theme production uses — its
# product templates fire the hook anchors the booking form / location line
# attach to), otherwise responsive. Set explicitly to force one:
#   CSCART_THEME=nova_theme
#   CSCART_THEME=responsive
# Changing this only affects a FRESH provision (docker compose down -v).
CSCART_THEME=

# Published ports (change these AND CSCART_HTTP_HOST together if 8080 is taken).
HTTP_PORT=8080
DB_PORT=3307
MAILPIT_PORT=8025
PMA_PORT=8081

# Database — defaults match the bundled `db` service. Change only deliberately.
CSCART_DB_NAME=cscart
CSCART_DB_USER=cscart
CSCART_DB_PASSWORD=cscart
